{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "/DMD.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/DMD.html" }
  ],
  "headers": [
    {
      "source": "/DMD.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
